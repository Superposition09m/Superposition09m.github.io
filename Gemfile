  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'

# Ruby >= 3.4 removed these from the default gems; jekyll 3.9 (github-pages)
# still requires them. Only affects local dev; GitHub Pages builds remotely.
